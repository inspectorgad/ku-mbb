# Gradle output. `/build` is only the root project's; app/ and shared/ each
# have one of their own, and an unanchored rule covers all three. A local
# build otherwise leaves hundreds of untracked files in `git status`, which is
# how they get committed.
build/
/captures
.externalNativeBuild
.cxx
local.properties
.env
debug.keystore

# Python bytecode from the pipeline scripts; two of these were committed by
# accident and every new module adds another.
__pycache__/
*.pyc
